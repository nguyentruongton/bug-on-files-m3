{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Materials",
  "version": "0.1.0",
  "identifier": "com.material3.filemanager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Materials",
        "width": 1100,
        "height": 720,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' media: data: blob:; media-src 'self' media: blob: data:; frame-src 'self' media: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost tauri: ws: http: https:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
