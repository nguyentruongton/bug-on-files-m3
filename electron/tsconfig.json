{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "outDir": "../dist-electron",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "."
    ],
    "exclude": [
        "**/__tests__/**",
        "**/*.test.ts"
    ]
}